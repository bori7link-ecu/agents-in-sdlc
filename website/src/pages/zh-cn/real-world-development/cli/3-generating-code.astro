---
const target = `${import.meta.env.BASE_URL}zh-cn/real-world-development/cli/3-agent-modes/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="zh-CN" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>正在重定向到计划并从议题构建</title>
  </head>
  <body>
    <a href={target}>本课程已迁移。继续学习如何计划并从议题构建。</a>
  </body>
</html>
